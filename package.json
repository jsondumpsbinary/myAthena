
{
  "name": "desktop-project",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "dev": "vite",
    "electron:dev": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "package": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.myathena.desktop",
    "productName": "myAthena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    }
  }
}
